  wishlist_offer_items_wishlist_offer_items_inventory_item_id_offerer_store_idToinventory_items wishlist_offer_items[]           @relation("wishlist_offer_items_inventory_item_id_offerer_store_idToinventory_items")
  wishlist_offer_items_wishlist_offer_items_inventory_item_id_offerer_user_idToinventory_items  wishlist_offer_items[]           @relation("wishlist_offer_items_inventory_item_id_offerer_user_idToinventory_items")
  wishlist_offer_requested_items                                                                wishlist_offer_requested_items[]
