  listing_id                                                          String                     @db.Uuid
  offerer_user_id                                                     String?                    @db.Uuid
  offerer_store_id                                                    String?                    @db.Uuid
  cash_amount                                                         Decimal                    @default(0) @db.Decimal(12, 2)
  currency_code                                                       String                     @default("USD")
  message                                                             String?
  visibility                                                          String                     @default("owner_only")
  status                                                              String                     @default("pending")
  expires_at                                                          DateTime?                  @db.Timestamptz(6)
  responded_at                                                        DateTime?                  @db.Timestamptz(6)
  created_at                                                          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                                          DateTime                   @default(now()) @db.Timestamptz(6)
  game_id                                                             String                     @db.Uuid
  inventory_item_interests                                            inventory_item_interests[]
  listings                                                            listings                   @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listing_offers_listing")
  listings_listing_offers_listing_id_game_idTolistings                listings                   @relation("listing_offers_listing_id_game_idTolistings", fields: [listing_id, game_id], references: [id, game_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listing_offers_listing_same_game")
  stores                                                              stores?                    @relation(fields: [offerer_store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listing_offers_offer_store")
  store_games                                                         store_games?               @relation(fields: [offerer_store_id, game_id], references: [store_id, game_id], onUpdate: NoAction, map: "fk_listing_offers_offer_store_game")
  user_profiles                                                       user_profiles?             @relation(fields: [offerer_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listing_offers_offer_user")
  offer_items_offer_items_offer_idTolisting_offers                    offer_items[]              @relation("offer_items_offer_idTolisting_offers")
  offer_items_offer_items_offer_id_game_idTolisting_offers            offer_items[]              @relation("offer_items_offer_id_game_idTolisting_offers")
  offer_items_offer_items_offer_id_offerer_store_idTolisting_offers   offer_items[]              @relation("offer_items_offer_id_offerer_store_idTolisting_offers")
  offer_items_offer_items_offer_id_offerer_user_idTolisting_offers    offer_items[]              @relation("offer_items_offer_id_offerer_user_idTolisting_offers")
  transactions_transactions_accepted_offer_id_game_idTolisting_offers transactions[]             @relation("transactions_accepted_offer_id_game_idTolisting_offers")
  transactions                                                        transactions?

  @@unique([id, listing_id], map: "uq_listing_offers_id_listing")
  @@unique([id, offerer_store_id], map: "uq_listing_offers_id_offerer_store")
  @@unique([id, offerer_user_id], map: "uq_listing_offers_id_offerer_user")
  @@unique([id, game_id], map: "uq_listing_offers_id_game")
  @@index([created_at(sort: Desc)], map: "idx_listing_offers_created_at")
  @@index([listing_id], map: "idx_listing_offers_listing_id")
  @@index([offerer_store_id], map: "idx_listing_offers_offer_store_id")
  @@index([offerer_user_id], map: "idx_listing_offers_offer_user_id")
  @@index([status], map: "idx_listing_offers_status")
  @@index([game_id], map: "idx_listing_offers_game_id")
}

