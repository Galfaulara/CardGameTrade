  listings_listings_inventory_item_id_seller_user_idToinventory_items                           listings[]                        @relation("listings_inventory_item_id_seller_user_idToinventory_items")
  offer_items_offer_items_inventory_item_id_offerer_store_idToinventory_items                   offer_items[]                    @relation("offer_items_inventory_item_id_offerer_store_idToinventory_items")
  offer_items_offer_items_inventory_item_id_offerer_user_idToinventory_items                    offer_items[]                    @relation("offer_items_inventory_item_id_offerer_user_idToinventory_items")
