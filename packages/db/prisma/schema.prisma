generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model canonical_cards {
  id                             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id                        String                           @db.Uuid
  source                         String                           @default("scryfall")
  source_key                     String
  name                           String
  normalized_name                String
  mana_cost                      String?
  type_line                      String?
  oracle_text                    String?
  colors                         String[]                         @default([])
  color_identity                 String[]                         @default([])
  raw_data                       Json?
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  games                          games                            @relation(fields: [game_id], references: [id], onUpdate: NoAction, map: "fk_canonical_cards_game")
  card_printings                 card_printings[]
  wishlist_items                 wishlist_items[]
  wishlist_offer_requested_items wishlist_offer_requested_items[]

  @@unique([id, game_id], map: "uq_canonical_cards_id_game")
  @@unique([game_id, source, source_key], map: "uq_canonical_cards_source")
}

model card_printings {
  id                             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id                        String                           @db.Uuid
  canonical_card_id              String                           @db.Uuid
  card_set_id                    String                           @db.Uuid
  source                         String                           @default("scryfall")
  source_key                     String
  collector_number               String
  language_code                  String                           @default("en")
  printed_name                   String?
  printed_type_line              String?
  printed_text                   String?
  rarity                         String?
  artist_name                    String?
  treatment                      String?
  frame_version                  String?
  border_color                   String?
  is_promo                       Boolean                          @default(false)
  is_reprint                     Boolean                          @default(false)
  is_digital                     Boolean                          @default(false)
  released_at                    DateTime?                        @db.Date
  image_small_uri                String?
  image_normal_uri               String?
  image_large_uri                String?
  raw_data                       Json?
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  canonical_cards                canonical_cards                  @relation(fields: [canonical_card_id, game_id], references: [id, game_id], onUpdate: NoAction, map: "fk_card_printings_canonical_same_game")
  games                          games                            @relation(fields: [game_id], references: [id], onUpdate: NoAction, map: "fk_card_printings_game")
  card_sets                      card_sets                        @relation(fields: [card_set_id, game_id], references: [id, game_id], onUpdate: NoAction, map: "fk_card_printings_set_same_game")
  printing_finishes              printing_finishes[]
  wishlist_items                 wishlist_items[]
  wishlist_offer_requested_items wishlist_offer_requested_items[]

  @@unique([source, source_key], map: "uq_card_printings_source")
}

model card_sets {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id        String           @db.Uuid
  code           String
  name           String
  source         String           @default("scryfall")
  source_id      String?
  release_date   DateTime?        @db.Date
  set_type       String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  card_printings card_printings[]
  games          games            @relation(fields: [game_id], references: [id], onUpdate: NoAction, map: "fk_card_sets_game")

  @@unique([game_id, code], map: "uq_card_sets_game_code")
  @@unique([id, game_id], map: "uq_card_sets_id_game")
  @@unique([source, source_id], map: "uq_card_sets_source")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model collections {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @db.Uuid
  name            String
  description     String?
  visibility      String            @default("private")
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  user_profiles   user_profiles     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_collections_user")
  inventory_items inventory_items[]

  @@unique([id, user_id], map: "uq_collections_id_user")
  @@unique([user_id, name], map: "uq_collections_user_name")
  @@index([user_id], map: "idx_collections_user_id")
}

model games {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @unique
  slug            String            @unique
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  canonical_cards canonical_cards[]
  card_printings  card_printings[]
  card_sets       card_sets[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_item_interests {
  id                          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventory_item_id           String           @db.Uuid
  interested_user_id          String?          @db.Uuid
  interested_store_id         String?          @db.Uuid
  interest_type               String           @default("buy_or_trade")
  message                     String?
  status                      String           @default("active")
  converted_listing_offer_id  String?          @db.Uuid
  converted_wishlist_offer_id String?          @db.Uuid
  converted_at                DateTime?        @db.Timestamptz(6)
  created_at                  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime         @default(now()) @db.Timestamptz(6)
  inventory_items             inventory_items  @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_item_interests_inventory_item")
  listing_offers              listing_offers?  @relation(fields: [converted_listing_offer_id], references: [id], onUpdate: NoAction, map: "fk_inventory_item_interests_listing_offer")
  stores                      stores?          @relation(fields: [interested_store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_item_interests_store")
  user_profiles               user_profiles?   @relation(fields: [interested_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_item_interests_user")
  wishlist_offers             wishlist_offers? @relation(fields: [converted_wishlist_offer_id], references: [id], onUpdate: NoAction, map: "fk_inventory_item_interests_wishlist_offer")

  @@unique([inventory_item_id, interested_store_id], map: "uq_inventory_item_interests_active_store", where: raw("((status = 'active'::text) AND (interested_store_id IS NOT NULL))"))
  @@unique([inventory_item_id, interested_user_id], map: "uq_inventory_item_interests_active_user", where: raw("((status = 'active'::text) AND (interested_user_id IS NOT NULL))"))
  @@index([interested_store_id], map: "idx_inventory_item_interests_interested_store_id")
  @@index([interested_user_id], map: "idx_inventory_item_interests_interested_user_id")
  @@index([inventory_item_id], map: "idx_inventory_item_interests_inventory_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_item_photos {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventory_item_id String          @unique(map: "uq_inventory_item_photos_one_primary", where: raw("(is_primary = true)")) @db.Uuid
  storage_provider  String          @default("supabase")
