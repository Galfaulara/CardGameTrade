  transaction_items                                                                             transaction_items[]              @relation("transaction_items_inventory_item_idToinventory_items")
  transaction_items_transaction_items_result_inventory_item_idToinventory_items                 transaction_items[]              @relation("transaction_items_result_inventory_item_idToinventory_items")
