{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
"main": "./dist/index.js",
"types": "./dist/index.d.ts",
"exports": {
  ".": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  }
},
  "scripts": {
    "check-types": "tsc --noEmit",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "bulk-import:inventory": "npm run build && node dist/scripts/bulk-inventory-import.js",
    "fixtures:marketplace-preview": "npm run build && node dist/scripts/seed-marketplace-preview-listings.js",
    "fixtures:user-preferred-stores": "npm run build && node dist/scripts/seed-user-preferred-stores.js",
    "fixtures:multigame:catalog": "npm run build && node dist/scripts/seed-multigame-catalog-fixtures.js",
    "fixtures:multigame:catalog:apply": "npm run build && node dist/scripts/seed-multigame-catalog-fixtures.js --apply",
    "fixtures:multigame:catalog:cleanup": "npm run build && node dist/scripts/seed-multigame-catalog-fixtures.js --cleanup",
    "fixtures:multigame:verify": "npm run build && node dist/scripts/verify-multigame-fixtures.js",
    "fixtures:multigame:marketplace": "npm run build && node dist/scripts/seed-multigame-marketplace-fixtures.js",
    "fixtures:multigame:marketplace:apply": "npm run build && node dist/scripts/seed-multigame-marketplace-fixtures.js --apply",
    "fixtures:multigame:marketplace:cleanup": "npm run build && node dist/scripts/seed-multigame-marketplace-fixtures.js --cleanup",
    "fixtures:multigame:marketplace:verify": "npm run build && node dist/scripts/verify-multigame-marketplace-fixtures.js",
    "auth:link-clerk": "npm run build && node dist/scripts/link-clerk-identity.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@repo/types": "*",
    "dotenv": "^16.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.2"
  }
}
