  "dependencies": {
    "@clerk/backend": "^3.16.12",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@repo/db": "^0.0.0",
    "@repo/domain": "*",
    "@repo/types": "*",
    "@repo/validation": "*",
    "@supabase/supabase-js": "^2.112.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "stream-json": "^3.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.3",
