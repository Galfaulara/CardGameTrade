{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test:profile": "tsc -p tsconfig.test.json && node dist-test/test/profile-regression.js",
    "test:onboarding": "tsc -p tsconfig.test.json && node dist-test/test/onboarding-regression.js",
    "test:authorization": "tsc -p tsconfig.test.json && node dist-test/test/authenticated-authorization-regression.js",
